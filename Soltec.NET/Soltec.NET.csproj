<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net9.0-ios;net9.0-maccatalyst;net9.0-android36.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Soltec.NET</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Soltec 4.0</ApplicationTitle>
		<ApplicationId>com.companyname.soltecpep</ApplicationId>

		<ApplicationDisplayVersion>1.0.100</ApplicationDisplayVersion>
		<ApplicationVersion>100</ApplicationVersion>

		<!--
			Versión que se ANUNCIA en el aviso de actualización (ver AGENTS.md §6.1).
			OJO: no es la que estás compilando arriba, es la que ya está disponible en el
			canal ALPHA (el más amplio). Se sube recién cuando promovés de prueba interna
			a alpha, no cuando lanzás a prueba interna.
			Motivo: la app no puede saber de qué canal de Play fue instalada. Si acá
			pusieras la versión de prueba interna, los técnicos de alpha verían el aviso
			en cada inicio durante 3 días sin tener cómo actualizar.
		-->
		<VersionEnAlpha>100</VersionEnAlpha>
		<VersionEnAlphaNombre>1.0.100</VersionEnAlphaNombre>

		<!--
			Texto del aviso de actualización. Es genérico: no hace falta cambiarlo en cada
			versión. Ojo: no usar ';' acá, MSBuild lo interpreta como separador y partiría
			el JSON en dos líneas.
		-->
		<NotasActualizacion>Se encontró una nueva versión de la aplicación. Actualizala desde Google Play para seguir trabajando con la última versión.</NotasActualizacion>

		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<Description>SolTec.NET es una aplicación móvil desarrollada en .NET MAUI.</Description>

		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android36.0|AnyCPU'">
		<AndroidKeyStore>False</AndroidKeyStore>
		<DefineConstants>$(DefineConstants);__ANDROID__</DefineConstants>
		<AndroidUseAapt2>True</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android36.0|x64'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	  <DefineConstants>$(DefineConstants);__ANDROID__</DefineConstants>
	  <AndroidUseAapt2>True</AndroidUseAapt2>
	  <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	  <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android36.0|AnyCPU'">
		<AndroidKeyStore>False</AndroidKeyStore>
		<DefineConstants>$(DefineConstants);__ANDROID__</DefineConstants>
		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<AndroidUseAapt2>True</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
		<RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android36.0|x64'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	  <DefineConstants>$(DefineConstants);__ANDROID__</DefineConstants>
	  <AndroidPackageFormat>aab</AndroidPackageFormat>
	  <AndroidUseAapt2>True</AndroidUseAapt2>
	  <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
	  <RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1565C0" BaseSize="256,256" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiIcon Include="Resources\AppIcon\soltec_icon.svg" Color="#FEFEFE" BaseSize="512,512" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="12.2.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.9" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.110" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<!--
		Splash con versión automática:
		Toma Resources\Splash\splash.svg (diseño limpio, sin versión), le inyecta el
		texto "v$(ApplicationDisplayVersion)" antes de </svg> y genera una copia en obj\.
		Luego apunta el MauiSplashScreen a esa copia. Corre antes de que el resizetizer
		recolecte/hashee el splash, así la versión siempre coincide con el .csproj.
	-->
	<Target Name="GenerarSplashConVersion" BeforeTargets="ResizetizeCollectItems">
		<PropertyGroup>
			<_SplashTemplate>$(MSBuildProjectDirectory)\Resources\Splash\splash.svg</_SplashTemplate>
			<_SplashGeneradoDir>$(IntermediateOutputPath)splashversion\</_SplashGeneradoDir>
			<_SplashGenerado>$(_SplashGeneradoDir)splash.svg</_SplashGenerado>
			<_SplashTextoVersion>&lt;text x="256" y="486" font-family="Arial, Helvetica, sans-serif" font-size="30" font-weight="bold" fill="#FFFFFF" text-anchor="middle"&gt;v$(ApplicationDisplayVersion)&lt;/text&gt;</_SplashTextoVersion>
		</PropertyGroup>

		<MakeDir Directories="$(_SplashGeneradoDir)" />

		<WriteLinesToFile
			File="$(_SplashGenerado)"
			Lines="$([System.IO.File]::ReadAllText('$(_SplashTemplate)').Replace('&lt;/svg&gt;','$(_SplashTextoVersion)%0a&lt;/svg&gt;'))"
			Overwrite="true"
			WriteOnlyWhenDifferent="true" />

		<ItemGroup>
			<MauiSplashScreen Remove="@(MauiSplashScreen)" />
			<MauiSplashScreen Include="$(_SplashGenerado)" Color="#1565C0" BaseSize="256,256" />
		</ItemGroup>
	</Target>

	<!--
		Genera Extras/app-version.json a partir de VersionEnAlpha / VersionEnAlphaNombre,
		para que el aviso de actualización no se escriba a mano (ver AGENTS.md §6.1).
		Deliberadamente NO usa ApplicationVersion: lo que se anuncia es lo que está en
		alpha, no lo que se está compilando para prueba interna.
		Solo se regenera el archivo si el contenido cambió, así no ensucia el working tree
		en cada build. Corre únicamente en el TFM de Android para no escribirlo varias
		veces en paralelo cuando se compilan todas las plataformas juntas.
		Publicarlo sigue siendo manual: recién con el git push los técnicos ven el aviso.
	-->
	<Target Name="GenerarAppVersionJson" BeforeTargets="Build"
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PropertyGroup>
			<_AppVersionJson>$(MSBuildProjectDirectory)\..\Extras\app-version.json</_AppVersionJson>
			<_AppVersionContenido>{%0a  &quot;VersionCode&quot;: $(VersionEnAlpha),%0a  &quot;VersionName&quot;: &quot;$(VersionEnAlphaNombre)&quot;,%0a  &quot;Notas&quot;: &quot;$(NotasActualizacion)&quot;%0a}</_AppVersionContenido>
		</PropertyGroup>

		<WriteLinesToFile
			File="$(_AppVersionJson)"
			Lines="$(_AppVersionContenido)"
			Overwrite="true"
			WriteOnlyWhenDifferent="true" />
	</Target>

	<ItemGroup>
		<MauiXaml Update="Views\ConfiguracionView.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="Views\CalculoMotores.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="Views\ContenidoDetalleView.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="Views\Pañol.xaml" Generator="MSBuild:Compile" />
	</ItemGroup>
</Project>