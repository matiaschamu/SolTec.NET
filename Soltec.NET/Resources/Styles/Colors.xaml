<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Acento de los controles nativos (Button, Slider, Switch, ProgressBar...). -->
    <!-- Repuntado del violeta de plantilla al AZUL DE MARCA (= AccentBlue #1565C0). -->
    <!-- Styles.xaml usa estas keys; por eso se conservan los nombres. -->
    <Color x:Key="Primary">#1565C0</Color>
    <Color x:Key="PrimaryDark">#64B5F6</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#BBDEFB</Color>
    <Color x:Key="SecondaryDarkText">#90CAF9</Color>
    <Color x:Key="Tertiary">#0D47A1</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- ================================================================= -->
    <!-- SolTec — Paleta de marca                                          -->
    <!-- Fuente única de verdad para los colores de la app.                -->
    <!-- Estética objetivo: minimalista y moderna (ver AGENTS.md §4).      -->
    <!-- No hardcodear colores nuevos en los XAML: agregarlos acá.         -->
    <!-- (Las keys de arriba son la plantilla MAUI; las usa Styles.xaml.)  -->
    <!-- ================================================================= -->

    <!-- Superficies y neutros -->
    <Color x:Key="AppBackground">#F5F7FA</Color>
    <Color x:Key="CardBorder">#CFD8DC</Color>
    <Color x:Key="PanolCardBackground">#F9F9F9</Color>
    <Color x:Key="PanolCardBorder">#BDBDBD</Color>
    <SolidColorBrush x:Key="PanolCardBorderBrush" Color="{StaticResource PanolCardBorder}" />

    <!-- Texto -->
    <Color x:Key="TextPrimary">#263238</Color>
    <Color x:Key="TextHeading">#607D8B</Color>
    <Color x:Key="TextStrong">#333333</Color>
    <Color x:Key="TextBody">#555555</Color>
    <Color x:Key="TextMuted">#777777</Color>

    <!-- Calculadora de motores -->
    <Color x:Key="MotorInputBackground">#F8FAFC</Color>
    <Color x:Key="MotorResultBackground">#EAF2FB</Color>
    <Color x:Key="MotorNoticeBackground">#FFF8E1</Color>
    <Color x:Key="MotorNoticeText">#795548</Color>

    <!-- Acentos semánticos -->
    <Color x:Key="AccentBlue">#1565C0</Color>
    <Color x:Key="Danger">Red</Color>
    <Color x:Key="DangerSoft">#E57373</Color>
    <Color x:Key="PriceGreen">#28A745</Color>
    <Color x:Key="QuantityBlue">#007BFF</Color>

    <!-- Estado de un manual (lo resuelve BoolToColorConverter desde código) -->
    <Color x:Key="ManualOffline">#006400</Color>
    <!-- descargado / disponible offline -->
    <Color x:Key="ManualOnline">#4682B4</Color>
    <!-- solo online -->
    <Color x:Key="ManualEstadoFallback">#808080</Color>
    <!-- value no booleano -->
    <SolidColorBrush x:Key="ManualOfflineBrush" Color="{StaticResource ManualOffline}" />
    <SolidColorBrush x:Key="ManualOnlineBrush" Color="{StaticResource ManualOnline}" />

    <!-- Tiles del menú principal (dashboard de herramientas) -->
    <Color x:Key="TilePanol">#4C51BF</Color>
    <Color x:Key="TileManuales">#2B6CB0</Color>
    <Color x:Key="TilePlanos">#805AD5</Color>
    <Color x:Key="TilePoliticas">#2C3E50</Color>
    <Color x:Key="TileCeldasCarga">#0F4C5C</Color>
    <Color x:Key="TileGPID">#34495E</Color>
    <Color x:Key="TileClaves">#5B2C6F</Color>
    <Color x:Key="TileQR">#1F618D</Color>
    <Color x:Key="TileTermocupla">#B03A2E</Color>
    <Color x:Key="TileMachos">#7D3C98</Color>
    <Color x:Key="TileRoscas">#2874A6</Color>
    <Color x:Key="TileHPKw">#117A65</Color>
    <Color x:Key="TileMotores">#900C3F</Color>
    <Color x:Key="TileConversion">#212F3D</Color>
    <Color x:Key="TileIntercambiadores">#D35400</Color>
    <!-- naranja "calor/hornos" -->

</ResourceDictionary>
