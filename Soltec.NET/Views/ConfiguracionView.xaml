<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Soltec.NET.ViewModels" 
             xmlns:models="clr-namespace:Soltec.NET.Models"
             x:Class="Soltec.NET.Views.ConfiguracionView"
             x:Name="ViewConfiguracion"
             Title="Configuracion"
             BackgroundColor="{StaticResource AppBackground}"
             x:DataType="viewmodels:ConfiguracionViewModel">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Configuración" 
               FontSize="26" 
               FontAttributes="Bold"
               TextColor="{StaticResource TextHeading}"
               HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding CarpetasUpdate}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CarpetaItemsUpdate">
                        <Frame HasShadow="True"
                               CornerRadius="15"
                               Padding="20"
                               BackgroundColor="{StaticResource White}"
                               BorderColor="{StaticResource CardBorder}">

                            <VerticalStackLayout Spacing="15">

                                <Label Text="{Binding Nombre}" 
                                       FontAttributes="Bold" 
                                       FontSize="20"
                                       TextColor="{StaticResource TextPrimary}"/>

                                 <Button Text="Sincronizar"
                                     CornerRadius="8"
                                     Command="{Binding BindingContext.SincronizarCarpetaCommand, Source={x:Reference ViewConfiguracion}}"
                                     CommandParameter="{Binding .}"
                                     IsEnabled="{Binding CanSincronizar}" 
                                     BackgroundColor="{Binding BotonColor}"
                                     TextColor="{Binding TextoBotonColor}"/>

                                 <Button Text="Detener Sincronización"
                                     CornerRadius="8"
                                     Command="{Binding BindingContext.DetenerSincronizacionCommand, Source={x:Reference ViewConfiguracion}}"
                                     CommandParameter="{Binding .}"
                                     IsVisible="{Binding IsSincronizando}" 
                                     BackgroundColor="{StaticResource Danger}"
                                     TextColor="{StaticResource White}"/>

                                 <Button Text="Borrar Contenido"
                                     CornerRadius="8"
                                     Command="{Binding BindingContext.BorrarCarpetaIndividualCommand, Source={x:Reference ViewConfiguracion}}"
                                     CommandParameter="{Binding .}"
                                     BackgroundColor="{StaticResource DangerSoft}"
                                     TextColor="{StaticResource White}"/>

                                <Label Text="{Binding EstadoArchivos}" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Danger}" />

                                <Label Text="{Binding ProgresoDescarga}" 
                                   FontAttributes="Italic"
                                   FontSize="13"
                                   TextColor="{StaticResource AccentBlue}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Borrar todo el contenido"
                BackgroundColor="{StaticResource Danger}"
                TextColor="{StaticResource White}"
                CornerRadius="8"
                Command="{Binding BorrarTodoCommand}" />

            <Frame IsVisible="{Binding RegistroDiagnosticoDisponible}"
                   HasShadow="True"
                   CornerRadius="15"
                   Padding="20"
                   BackgroundColor="{StaticResource White}"
                   BorderColor="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Diagnóstico de errores"
                           FontAttributes="Bold"
                           FontSize="20"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Los registros se guardan solamente en este dispositivo. Podés exportarlos manualmente para analizar un problema."
                           FontSize="14"
                           TextColor="{StaticResource TextMuted}" />
                    <Button Text="Exportar diagnóstico"
                            CornerRadius="8"
                            Command="{Binding ExportarDiagnosticoCommand}"
                            BackgroundColor="{StaticResource AccentBlue}"
                            TextColor="{StaticResource White}" />
                    <Button Text="Borrar registros"
                            CornerRadius="8"
                            Command="{Binding BorrarDiagnosticoCommand}"
                            BackgroundColor="{StaticResource DangerSoft}"
                            TextColor="{StaticResource White}" />
                </VerticalStackLayout>
            </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsCargando}" 
                       IsVisible="{Binding IsCargando}" 
                       VerticalOptions="Center" 
                       HorizontalOptions="Center" 
                       Color="{StaticResource AccentBlue}"
                       HeightRequest="50"
                       WidthRequest="50" />
    </Grid>
</ContentPage>
