<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Soltec.NET.ViewModels" 
             xmlns:models="clr-namespace:Soltec.NET.Models"
             x:Class="Soltec.NET.Views.ConfiguracionView"
             x:Name="ViewConfiguracion"
             Title="Configuracion"
             BackgroundColor="#F5F7FA"
             x:DataType="viewmodels:ConfiguracionViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Configuración" 
               FontSize="26" 
               FontAttributes="Bold"
               TextColor="#607D8B"
               HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding CarpetasUpdate}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CarpetaItemsUpdate">
                        <Frame HasShadow="True"
                               CornerRadius="15"
                               Padding="20"
                               BackgroundColor="White"
                               BorderColor="#CFD8DC">

                            <VerticalStackLayout Spacing="15">

                                <Label Text="{Binding Nombre}" 
                                       FontAttributes="Bold" 
                                       FontSize="20"
                                       TextColor="#263238"/>

                                 <Button Text="Sincronizar"
                                     CornerRadius="8"
                                     Command="{Binding BindingContext.SincronizarCarpetaCommand, Source={x:Reference ViewConfiguracion}}"
                                     CommandParameter="{Binding .}"
                                     IsEnabled="{Binding CanSincronizar}" 
                                     BackgroundColor="{Binding BotonColor}"
                                     TextColor="{Binding TextoBotonColor}"/>

                                 <Button Text="Detener Sincronización"
                                     CornerRadius="8"
                                     Command="{Binding BindingContext.DetenerSincronizacionCommand, Source={x:Reference ViewConfiguracion}}"
                                     CommandParameter="{Binding .}"
                                     IsVisible="{Binding IsSincronizando}" 
                                     BackgroundColor="Red"
                                     TextColor="White"/>

                                 <Button Text="Borrar Contenido"
                                     CornerRadius="8"
                                     Command="{Binding BindingContext.BorrarCarpetaIndividualCommand, Source={x:Reference ViewConfiguracion}}"
                                     CommandParameter="{Binding .}"
                                     BackgroundColor="#E57373"
                                     TextColor="White"/>

                                <Label Text="{Binding EstadoArchivos}" 
                                   FontAttributes="Bold"
                                   TextColor="Red" />

                                <Label Text="{Binding ProgresoDescarga}" 
                                   FontAttributes="Italic"
                                   FontSize="13"
                                   TextColor="#1565C0"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Borrar todo el contenido"
        BackgroundColor="Red"
        TextColor="White"
        CornerRadius="8"
        Command="{Binding BorrarTodoCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>