<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soltec.NET.MainPage"
             Title="Soltec 4.0">

    <ContentPage.Resources>
        <!-- Estilo compartido de los textos de los tiles del menú.
             👉 Cambiá SOLO el FontSize de abajo para probar tamaños:
                se aplica a TODOS los botones a la vez. -->
        <Style x:Key="TileLabel" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{StaticResource White}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start" JustifyContent="Start" Margin="10" Padding="0">

            <Border FlexLayout.Basis="100%" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TilePanol}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPañolClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="Pañol 🛠️" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TileManuales}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnManualesClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="Manuales 📖" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TilePlanos}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPlanosClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="Planos 🗺️" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="100%" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TileIntercambiadores}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnIntercambiadoresClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="ConMon 📈" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TilePoliticas}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPoliticasClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="10" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="Políticas y&#10;Procedimientos&#10;📜" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TileCeldasCarga}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCeldasDeCargaClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="Celdas&#10;de carga&#10;⚖️" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TileGPID}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGPIDClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="GPID 🤖" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TileClaves}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClavesClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="Claves 🔑" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TileQR}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQRClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="QR 📱" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TileTermocupla}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTermocuplaClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="Termocupla&#10;PT100 🌡️" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TileMachos}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMachosClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="Machos 🔩" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TileRoscas}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRoscasClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="Roscas&#10;de gas 🗜️" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TileHPKw}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHPKwCorrienteClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="HP/Kw&#10;Corriente&#10;⚡" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TileMotores}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMotoresClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="Motores 💥" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <Border FlexLayout.Basis="48%" FlexLayout.Grow="1" HeightRequest="80" Margin="5" BackgroundColor="{StaticResource TileConversion}" StrokeShape="RoundRectangle 10,10,10,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnConversionClicked" />
                </Border.GestureRecognizers>
                <Grid Padding="5" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Label Text="Conversión de unidades 🔄" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

        </FlexLayout>
    </ScrollView>
</ContentPage>
